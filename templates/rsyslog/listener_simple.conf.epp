<%- | Integer $port, String $certname, String $log_root, Integer $max_sessions, Boolean $notify_on_connection_close | -%>
# TLS listener
module(load="imtcp")
global(
  DefaultNetstreamDriver="gtls"
  DefaultNetstreamDriverCAFile="/etc/rsyslog.d/tls/ca.pem"
  DefaultNetstreamDriverCertFile="/etc/rsyslog.d/tls/<%= $certname %>.pem"
  DefaultNetstreamDriverKeyFile="/etc/rsyslog.d/tls/<%= $certname %>.key"
)
input(
  type="imtcp"
  port="<%= $port %>"
  maxSessions="<%= $max_sessions %>"
  notifyOnConnectionClose="<%= $notify_on_connection_close ? { true => 'on', default => 'off' } %>"
  streamdriver.mode="1"
  streamdriver.authMode="x509/certvalid"   # accept any cert signed by CA
)
template(name="remote" type="list") {
  constant(value="<%= $log_root %>/hosts/")
  property(name="hostname" securePath="replace")
  constant(value="/")
  property(name="programname" securePath="replace")
  constant(value=".log")
}

template(name="remote_unknown_program" type="list") {
  constant(value="<%= $log_root %>/hosts/")
  property(name="hostname" securePath="replace")
  constant(value="/unknown.log")
}

if ($programname == '') then {
  action(type="omfile" dynaFile="remote_unknown_program" createDirs="on")
} else {
  action(type="omfile" dynaFile="remote" createDirs="on")
}
