<%- | String $log_root | -%>
<%= $log_root %>/hosts/*/*.log <%= $log_root %>/hosts/*/.log {
    daily
    rotate -1
    nocompress
    dateext
    dateformat -%Y%m%d
    missingok
    sharedscripts
    postrotate
        /bin/systemctl kill -s HUP rsyslog.service >/dev/null 2>&1 || true
    endscript
}
